# Family Space — environment variables (copy to .env on VPS)

POSTGRES_USER=familyspace
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=familyspace

JWT_SECRET=change-me-to-a-random-string-at-least-32-characters
JWT_ISSUER=familyspace
JWT_AUDIENCE=familyspace-users

# OAuth 2.0 Web client ID (same value as google.web.client.id in local.properties)
GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# Temporary dev login bypass — disable in production (DEV_AUTH_BYPASS=false)
DEV_AUTH_BYPASS=false
DEV_AUTH_SECRET=
DEV_AUTH_EMAIL=zamdec2@gmail.com

PUBLIC_BASE_URL=https://api.yourdomain.com
HOST=0.0.0.0
PORT=8080
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_BYTES=5242880

# Push notifications — service account JSON mounted at /app/firebase-admin.json in Docker
FIREBASE_ADMIN_JSON=/app/firebase-admin.json

# Admin moderation (must match app ModerationAccess.ADMIN_EMAIL)
ADMIN_EMAIL=deceirem@gmail.com
